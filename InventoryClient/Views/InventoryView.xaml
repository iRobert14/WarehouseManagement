<UserControl x:Class="InventoryClient.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right"
                    Content="↻  Reîncarcă"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="Se încarcă..."
                       Foreground="{StaticResource MutedTextBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
            <StackPanel>
                <TextBlock Text="Stoc haine"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Caută, filtrează și urmărește stocul"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="4" Margin="-6,0,-6,16">
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Produse afișate" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding TotalProducts}" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Bucăți în stoc" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding TotalUnits, StringFormat=N0}" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Valoare stoc" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding StockValue, StringFormat='{}{0:N2} lei'}" Style="{StaticResource CardValue}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="6,0">
                <StackPanel>
                    <TextBlock Text="Stoc redus" Style="{StaticResource CardLabel}"/>
                    <TextBlock Text="{Binding LowStockCount}"
                               Style="{StaticResource CardValue}"
                               Foreground="{StaticResource WarningBrush}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Style="{StaticResource InputBox}"
                     Tag="Caută după nume, SKU sau culoare..."
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <ComboBox Grid.Column="1"
                      Margin="12,0,0,0"
                      Style="{StaticResource DarkComboBox}"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"/>

            <ToggleButton Grid.Column="2"
                          Margin="12,0,0,0"
                          Style="{StaticResource FilterChip}"
                          Content="Doar stoc redus"
                          IsChecked="{Binding ShowLowStockOnly}"/>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <DataGrid Style="{StaticResource DarkDataGrid}"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="150"/>
                        <DataGridTextColumn Header="Produs" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Mărime" Binding="{Binding Size}" Width="80"/>
                        <DataGridTextColumn Header="Culoare" Binding="{Binding Color}" Width="100"/>
                        <DataGridTextColumn Header="Preț" Binding="{Binding Price, StringFormat='{}{0:N2} lei'}" Width="110"/>
                        <DataGridTemplateColumn Header="Stoc" Width="140" SortMemberPath="Quantity">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Quantity}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Border x:Name="badge"
                                                Background="{StaticResource WarningBrush}"
                                                CornerRadius="6"
                                                Padding="6,1"
                                                Margin="8,0,0,0"
                                                Visibility="Collapsed">
                                            <TextBlock x:Name="badgeText"
                                                       Text="redus"
                                                       Foreground="#272537"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                            <Setter TargetName="badge" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Quantity}" Value="0">
                                            <Setter TargetName="badge" Property="Background" Value="{StaticResource DangerBrush}"/>
                                            <Setter TargetName="badgeText" Property="Text" Value="epuizat"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Niciun produs nu corespunde filtrelor."
                           Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Products.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,12"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>