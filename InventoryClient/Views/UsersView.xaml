<UserControl x:Class="InventoryClient.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:InventoryClient.Helpers">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="2,12,0,6"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right"
                    Content="+  Utilizator nou"
                    Style="{StaticResource PrimaryButton}"
                    Margin="10,0,0,0"
                    Command="{Binding NewUserCommand}"/>
            <Button DockPanel.Dock="Right"
                    Content="↻  Reîncarcă"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding RefreshCommand}"/>
            <StackPanel>
                <TextBlock Text="Utilizatori"
                           FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Creează conturi, schimbă roluri și controlează accesul"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <DataGrid Style="{StaticResource DarkDataGrid}"
                              ItemsSource="{Binding Users}"
                              SelectedItem="{Binding SelectedUser}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="IsActive">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="badge"
                                                Background="{StaticResource SuccessBrush}"
                                                CornerRadius="6"
                                                Padding="8,2"
                                                HorizontalAlignment="Left">
                                            <TextBlock x:Name="badgeText"
                                                       Text="Activ"
                                                       Foreground="#272537"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter TargetName="badge" Property="Background" Value="{StaticResource InputBrush}"/>
                                                <Setter TargetName="badgeText" Property="Text" Value="Inactiv"/>
                                                <Setter TargetName="badgeText" Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Creat la"
                                                Binding="{Binding CreatedAtUtc, StringFormat=dd.MM.yyyy}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,12"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Width="340"
                    Margin="16,0,0,0"
                    Padding="20,16"
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">

                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="✕"
                                    Style="{StaticResource TitleBarButton}"
                                    Command="{Binding CloseEditorCommand}"/>
                            <TextBlock Text="{Binding PanelTitle}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Tag="ex: ana.popescu"
                                 IsEnabled="{Binding IsNewUser}"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Rol" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource DarkComboBox}"
                                  ItemsSource="{Binding Roles}"
                                  SelectedItem="{Binding Role}"
                                  IsEnabled="{Binding CanEditRoleAndStatus}"/>

                        <StackPanel Visibility="{Binding IsExistingUser, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Acces" Style="{StaticResource FieldLabel}"/>
                            <ToggleButton Style="{StaticResource FilterChip}"
                                          Content="Cont activ"
                                          HorizontalAlignment="Left"
                                          IsChecked="{Binding IsActive}"
                                          IsEnabled="{Binding CanEditRoleAndStatus}"/>
                        </StackPanel>

                        <TextBlock Text="Nu îți poți schimba propriul rol și nici nu îți poți dezactiva propriul cont."
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="2,8,0,0"
                                   Visibility="{Binding IsEditingSelf, Converter={StaticResource BoolToVisibility}}"/>

                        <Button Content="Salvează"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,18,0,0"
                                Command="{Binding SaveCommand}"/>

                        <Border Height="1" Background="{StaticResource OutlineBrush}" Margin="0,20,0,0"/>

                        <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabel}"/>
                        <PasswordBox Style="{StaticResource PasswordInput}"
                                     Tag="min. 8 caractere, literă + cifră"
                                     helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Resetează parola"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,10,0,0"
                                Command="{Binding ResetPasswordCommand}"
                                Visibility="{Binding IsExistingUser, Converter={StaticResource BoolToVisibility}}"/>

                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="2,14,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>