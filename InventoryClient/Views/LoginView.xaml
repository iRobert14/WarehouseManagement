<UserControl x:Class="InventoryClient.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:InventoryClient.Helpers">
    <Grid>
        <StackPanel Width="280" HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="Warehouse"
                       FontSize="32" FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Gestiunea stocului de haine"
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,32"/>

            <TextBox Style="{StaticResource InputBox}"
                     Tag="Username"
                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12"/>

            <PasswordBox Style="{StaticResource PasswordInput}"
                         Tag="Parola"
                         helpers:PasswordBoxHelper.BoundPassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,20"/>

            <Button Style="{StaticResource PrimaryButton}"
                    Content="Login"
                    IsDefault="True"
                    Command="{Binding LoginCommand}"/>

            <TextBlock Text="Se conecteaza..."
                       Foreground="{StaticResource MutedTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,0"
                       Visibility="{Binding LoginCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,14,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>